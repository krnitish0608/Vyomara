{
  "name": "vyomara",
  "version": "1.0.0",
  "private": true,
  "description": "Vyomara — a local-first personal AI assistant",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/cli.ts",
    "desktop": "node scripts/desktop-app.mjs",
    "build": "electron-vite build",
    "package:mac": "node scripts/package-mac.mjs",
    "install:mac": "node scripts/package-mac.mjs --install",
    "check": "pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test",
    "test:desktop-ui": "electron-vite build && node scripts/desktop-ui-smoke.mjs",
    "eval": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/eval-agent.ts"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
