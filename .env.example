# Vyomara reads these from the environment; it does not load .env files.
VYOM_PROVIDER=ollama
VYOM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Any installed Ollama model with tool support. The desktop Models panel overrides this.
VYOM_OLLAMA_MODEL=qwen3:14b
# Context window requested from Ollama (tokens). Lower to 16384 if memory is tight.
VYOM_OLLAMA_NUM_CTX=32768
# Let thinking-capable models reason before answering (slower).
VYOM_OLLAMA_THINK=false
# Default: ~/Library/Application Support/Vyomara
# VYOM_DATA_DIR=/absolute/path/to/local/data
VYOM_REQUEST_TIMEOUT_MS=300000
VYOM_TOOL_TIMEOUT_MS=30000
VYOM_COMMAND_TIMEOUT_MS=120000
VYOM_MAX_AGENT_ITERATIONS=40
VYOM_MAX_TOOL_CALLS=80
VYOM_MAX_INPUT_CHARS=32000
VYOM_MAX_RESPONSE_CHARS=32000
# Whole Mac (minus protected paths) when unset; a JSON array narrows it; [] disables file tools.
# VYOM_ALLOWED_ROOTS=["/Users/you/Projects"]
VYOM_MAX_FILE_BYTES=2097152
VYOM_MAX_DIRECTORY_ENTRIES=300
VYOM_MAX_TREE_DEPTH=4
VYOM_MAX_TOOL_OUTPUT_CHARS=24000
VYOM_MAX_TOOL_INPUT_CHARS=400000
# Optional: a SearXNG instance (JSON format enabled) for web_search, e.g. a local one.
# VYOM_SEARXNG_URL=http://127.0.0.1:8888
